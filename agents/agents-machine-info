#!/bin/bash
# Keep an auto-generated "This machine" block in each agent instructions file
# (Claude, Codex, Hermes) so agents know which computer they're on.
# Only the text between the markers is rewritten; everything else is left alone.
#
# Runs at login: launchd (launchd/local.agents-machine-info.plist) on macOS,
# systemd --user (systemd/agents-machine-info.service) on Linux, and after
# `omarchy update` on Omarchy. Pass file paths to update only those files.

set -euo pipefail
export PATH="$PATH:/usr/sbin:/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin"

BEGIN="<!-- BEGIN machine-info (auto-generated by agents-machine-info; edits here are overwritten) -->"
END="<!-- END machine-info -->"

# --- Gather facts -----------------------------------------------------------
if [ "$(uname)" = "Darwin" ]; then
  host=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
  name=$(scutil --get ComputerName 2>/dev/null || true)
  hw=$(system_profiler SPHardwareDataType 2>/dev/null)
  field() { echo "$hw" | awk -F': ' -v k="$1" '$1 ~ k { print $2; exit }'; }
  model="$(field 'Model Name'), $(field 'Chip'), $(field 'Memory') RAM"
  os="macOS $(sw_vers -productVersion)"
  ts=/Applications/Tailscale.app/Contents/MacOS/Tailscale
  command -v tailscale >/dev/null && ts=tailscale
else
  host=$(hostnamectl hostname 2>/dev/null || hostname)
  name=""
  dmi() { cat "/sys/class/dmi/id/$1" 2>/dev/null || true; }
  cpu=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ *//')
  ram=$(awk '/MemTotal/ {printf "%.0f GB", $2/1024/1024}' /proc/meminfo)
  # Lenovo puts the marketing name in product_version; most others use
  # product_name and leave filler like "Default string" in product_version
  product=$(dmi product_version)
  case "$product" in ""|"Default string"|"To be filled by O.E.M."|"System Version"|"None") product=$(dmi product_name) ;; esac
  model="$(dmi sys_vendor | sed 's/LENOVO/Lenovo/; s/BESSTAR TECH LIMITED/Minisforum/') $product"
  model="${model## }, $cpu, $ram RAM"
  os="$(. /etc/os-release && echo "$PRETTY_NAME"), kernel $(uname -r)"
  command -v omarchy >/dev/null && os="Omarchy $(omarchy version 2>/dev/null) (Arch Linux + Hyprland), kernel $(uname -r)"
  ts=tailscale
fi

tailnet=""
if [ -x "$(command -v "$ts")" ] || [ -x "$ts" ]; then
  tailnet=$("$ts" status --self --json 2>/dev/null |
    jq -r '.Self | "\(.DNSName | rtrimstr(".")) (\(.TailscaleIPs[0]))"' 2>/dev/null || true)
fi

term=$(xdg-terminal-exec --print-id 2>/dev/null | sed 's/\.desktop$//' || true)

BLOCK="$BEGIN
## This machine
- Hostname: \`$host\`${name:+ (\"$name\")}${tailnet:+ — Tailscale \`$tailnet\`}
- Hardware: $model
- OS: $os
- Shell: $(basename "${SHELL:-sh}")${term:+, default terminal: $term}
- Refreshed: $(date '+%Y-%m-%d %H:%M')
$END"
export BLOCK BEGIN END

# --- Pick target files --------------------------------------------------------
targets=()
if [ $# -gt 0 ]; then
  targets=("$@")
else
  for f in "$HOME/AGENTS.md" "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md" "$HOME/.hermes/AGENTS.md"; do
    [ -f "$f" ] || continue
    # Symlinks usually point into a shared repo; don't write per-machine data there
    if [ -L "$f" ]; then echo "skip (symlink): $f" >&2; continue; fi
    # A CLAUDE.md that only imports ~/AGENTS.md gets the block through the import
    if [ "$f" = "$HOME/.claude/CLAUDE.md" ] && grep -q '^@~/AGENTS.md' "$f"; then continue; fi
    targets+=("$f")
  done
  # Nothing global for Claude yet: give it a CLAUDE.md that holds just the block
  if [ ! -e "$HOME/.claude/CLAUDE.md" ] && [ ! -e "$HOME/AGENTS.md" ] && [ -d "$HOME/.claude" ]; then
    targets+=("$HOME/.claude/CLAUDE.md")
  fi
fi

# --- Rewrite each target ------------------------------------------------------
for file in "${targets[@]}"; do
  touch "$file"
  tmp=$(mktemp "${TMPDIR:-/tmp}/agents-machine-info.XXXXXX")
  if grep -qF "$BEGIN" "$file"; then
    awk '
      $0 == ENVIRON["BEGIN"] { print ENVIRON["BLOCK"]; skip = 1; next }
      skip && $0 == ENVIRON["END"] { skip = 0; next }
      !skip { print }
    ' "$file" > "$tmp"
  else
    # First run: insert before the first "## " heading (after the title), or append
    awk '
      !done && NR > 1 && /^## / { print ENVIRON["BLOCK"]; print ""; done = 1 }
      { print }
      END { if (!done) { if (NR) print ""; print ENVIRON["BLOCK"] } }
    ' "$file" > "$tmp"
  fi
  # Write in place so permissions and ownership stay as they were
  cat "$tmp" > "$file"
  rm -f "$tmp"
  echo "updated: $file"
done
